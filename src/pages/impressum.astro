---
import Base from '../layouts/Base.astro';
import { rechtliches } from '../lib/rechtliches';

// Angaben kommen aus Christophs Inhalts-Repo (einstellungen/rechtliches.md, im Editor pflegbar).
const r = await rechtliches();
---
<Base titel="Impressum">
  <main class="rechtlich">
    <p class="eyebrow">Rechtliches</p>
    <h1>Impressum</h1>
    {!r.vollstaendig && <p class="hinweis">⚠ Noch nicht vollständig. Im Editor unter „Einstellungen → Impressum &amp; Kontakt“ ausfüllen.</p>}
    <p><b>Angaben gemäß § 5 DDG</b><br>
      {r.name}<br>
      {r.strasse}<br>
      {r.ort}</p>
    <p><b>Kontakt</b><br>E-Mail: {r.email}{r.telefon && <Fragment><br>Telefon: {r.telefon}</Fragment>}</p>
    <p><b>Verantwortlich für den Inhalt</b> nach § 18 Abs. 2 MStV: {r.name}, Anschrift wie oben.</p>
    <p><a class="btn" href="/">← Zur Weltkugel</a></p>
  </main>
</Base>
