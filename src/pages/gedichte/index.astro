---
// Alte Adresse: „Gedichte“ heißen jetzt „Gedanken“ (/gedanken/). Diese Seite leitet alte Links und Lesezeichen weiter.
const ziel = '/gedanken/';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Weitergeleitet zu den Gedanken</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={ziel} />
    <meta http-equiv="refresh" content={`0; url=${ziel}`} />
  </head>
  <body><p>Die Gedichte heißen jetzt Gedanken: <a href={ziel}>weiter</a>.</p></body>
</html>
