---
// Alte Adresse: „Gedichte“ heißen jetzt „Gedanken“ (/gedanken/<id>/). Diese Seite leitet alte Links weiter.
import { alleGedichte } from '../../lib/daten';
export async function getStaticPaths() {
  return (await alleGedichte()).map((g) => ({ params: { slug: g.id } }));
}
const ziel = `/gedanken/${Astro.params.slug}/`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Weitergeleitet zu den Gedanken</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={ziel} />
    <meta http-equiv="refresh" content={`0; url=${ziel}`} />
  </head>
  <body><p>Dieser Text ist umgezogen: <a href={ziel}>weiter</a>.</p></body>
</html>
