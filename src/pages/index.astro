---
import Base from '../layouts/Base.astro';
import site from '../../site.config.mjs';
import { alleEintraege, datumDE } from '../lib/daten';
const eintraege = await alleEintraege();
const neuester = eintraege[0];
---
<Base modus="home" bereich="tagebuch" bild={neuester?.data.titelbild} beschreibung={`${site.untertitel} von ${site.autor}: ${eintraege.length} Orte auf einer Weltkugel.`}>
  <a href="#archiv" class="skip" id="skipList">Zum Archiv aller Einträge springen</a>

  <main class="home" id="home">
    <h1 class="sr-only">{site.titel}</h1>
    <div class="dock" id="dock">
      <div class="pop" id="ctyPop" hidden><ul id="ctyList"></ul></div>
      <p class="stats" id="stats"></p>
      <div class="dock-btns">
        <button class="btn sm" id="listBtn" aria-haspopup="dialog" aria-controls="archiv">📍 <span class="hide-n">Alle </span>Einträge</button>
        <button class="btn sm" id="otdBtn" hidden>📅 Vor <span class="hide-n">einem</span><span class="show-n">1</span> Jahr</button>
        <button class="btn sm" id="randomBtn">🎲 Zufall</button>
        <button class="btn sm" id="zrBtn" aria-controls="zeitreise">▶ Zeitreise</button>
      </div>
    </div>
    {/* Zeitreise (globus.js): alles läuft der Reihe nach ab; Regler zum Vor- und Zurückspulen */}
    <div class="zeitreise" id="zeitreise" hidden role="group" aria-label="Zeitreise">
      <button class="zr-knopf" id="zrPlay" aria-label="Anhalten">⏸</button>
      <div class="zr-mitte">
        <div class="zr-kopf"><b id="zrDatum"></b><span id="zrZahlen"></span></div>
        <input type="range" id="zrRegler" min="0" max="1000" value="0" aria-label="Zeitpunkt" />
      </div>
      <button class="zr-knopf zr-zu" id="zrZu" aria-label="Zeitreise beenden">✕</button>
    </div>
    <div class="tc">
      <div class="cbar" id="cbar" hidden aria-live="polite"><div class="cb-top"><b id="cbName"></b><span id="cbPct"></span></div><span class="cb-meter"><i id="cbFill"></i></span><span class="cb-sub" id="cbSub"></span></div>
      <button class="worldbtn" id="worldBtn" hidden aria-label="Ganze Weltkugel zeigen">🌍<span class="wb-text"> Ganze Weltkugel zeigen</span></button>
    </div>
    {/* Quellenangabe für die Ortsnamen (CC BY 4.0), nur sichtbar, solange Ortsnamen auf dem Globus stehen */}
    <p class="ortquelle" id="ortQuelle" hidden>Ortsnamen: <a href="https://www.geonames.org/" target="_blank" rel="noopener">GeoNames</a> (CC BY 4.0)</p>
    <div class="zoomctl" role="group" aria-label="Zoom"><button id="zIn" aria-label="Hineinzoomen">+</button><button id="zOut" aria-label="Herauszoomen">−</button><button id="zReset" aria-label="Ansicht zurücksetzen" style="font-size:15px">⟲</button></div>

    {/* Ohne JavaScript: einfache Liste aller Einträge */}
    <noscript>
      <section class="rechtlich">
        <h2>Alle Einträge</h2>
        <ul>{eintraege.map((e) => <li><a href={`/${e.id}/`}>{e.data.titel}</a> · {e.data.ort}, {datumDE(e.data.datum)}</li>)}</ul>
      </section>
    </noscript>
  </main>

  {/* Archiv aller Einträge: Briefbogen wie beim Artikel, nach Jahr und Monat */}
  <div class="archiv" id="archiv" hidden>
    <div class="sheet archiv-blatt" role="dialog" aria-modal="true" aria-labelledby="arH">
      <div class="sheet-bar">
        <h2 id="arH">Archiv</h2>
        <button class="btn sm" id="arClose" aria-label="Archiv schließen">✕<span class="hide-n"> Schließen</span></button>
      </div>
      <nav class="ar-jahre" id="arJahre" aria-label="Jahre"></nav>
      <div id="entryList"></div>
    </div>
  </div>

  <div class="postcard" id="postcard" hidden role="dialog" aria-labelledby="pcTitle">
    <button class="pc-x" id="pcClose" aria-label="Postkarte schließen">✕</button>
    <div class="pc-in">
      <a class="pc-img" id="pcImgLink" href="/"><img id="pcImg" alt=""><span class="pc-hint" id="pcHint">Lesen</span></a>
      <div class="pc-body">
        <span class="pa">✈ PAR AVION</span>
        <p class="pc-eyebrow" id="pcEyebrow"></p>
        <h2 id="pcTitle"></h2>
        <p class="pc-meta" id="pcMeta"></p>
        <p class="pc-ex" id="pcEx" hidden></p>
      </div>
      <div class="pc-actions" id="pcActions"></div>
      {/* Stapel: mehrere Einträge am selben Ort – blättern per ‹ › oder Wischen (globus.js, stapelWechsel) */}
      <div class="pc-stapel" id="pcStapel" hidden><button id="pcVor" aria-label="Vorheriger Eintrag hier">‹</button><span id="pcNr"></span><button id="pcNach" aria-label="Nächster Eintrag hier">›</button></div>
      <div class="pc-pm" id="pcPm"></div>
    </div>
  </div>

  <div class="letter-wrap" id="letterWrap" hidden>
    <div class="letter" id="letter" role="dialog" aria-labelledby="ltTitle">
      <div class="pc-pm" id="ltPm"></div>
      <p class="lt-meta" id="ltMeta"></p>
      <h2 id="ltTitle"></h2>
      <div class="lt-body" id="ltBody"></div>
      <p class="lt-sign" id="ltSign"></p>
      <div class="lt-actions"><a class="pc-btn primary" id="ltLink" href="/gedanken/">Ganz lesen</a><a class="pc-btn" href="/gedanken/">Alle Gedanken →</a><button class="pc-btn" id="ltClose" style="margin-left:auto">Schließen</button></div>
    </div>
  </div>
</Base>
